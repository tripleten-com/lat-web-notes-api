{
  "name": "notes-api",
  "version": "1.0.0",
  "description": "Una API de notas sencilla: tu tarea es agregarle la autenticación",
  "type": "module",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec 'tsx src/index.ts'",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src",
    "format": "prettier --write src",
    "test:03": "tsx tests/lesson-03.js",
    "test:05": "node tests/lesson-05.js",
    "test:07": "node tests/lesson-07.js",
    "test:08": "node tests/lesson-08.js",
    "test:09": "node tests/lesson-09.js",
    "test:10": "node tests/lesson-10.js",
    "test:11": "node tests/lesson-11.js"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "express": "^5.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^22.0.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.1.2",
    "nodemon": "^3.1.4",
    "prettier": "^3.8.3",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.59.3"
  }
}
